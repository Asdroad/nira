NIRA_ENV=local
NIRA_DATABASE_URL=sqlite:///.data/nira.db
NIRA_STORAGE_PATH=.data/files
NIRA_COOKIE_SECURE=false
NIRA_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
NIRA_MAX_FILE_MB=25
NIRA_OCR_ENABLED=true
NIRA_OCR_LANGUAGES=rus+eng
NIRA_OCR_MAX_PAGES=30
NIRA_DOCUMENT_TIMEOUT=180
OPENROUTER_API_KEY=
NIRA_AI_ENABLED=true
NIRA_AI_AUTO_RUN=true
NIRA_AI_MODEL=openai/gpt-6-luna
NIRA_AI_TIMEOUT=120
NIRA_AI_MAX_CONTEXT_CHARS=100000
NIRA_AI_MAX_OUTPUT_TOKENS=8000
# Maximum accepted provider prices in USD per million tokens.
NIRA_AI_MAX_INPUT_PRICE=0.1
NIRA_AI_MAX_OUTPUT_PRICE=0.5
NIRA_AI_REQUEST_BUDGET_USD=0.02
NIRA_AI_TASK_BUDGET_USD=0.10
# Outbound services are configured separately.
SEARCH_API_KEY=
MAIL_PROVIDER_TOKEN=
PAYMENT_PROVIDER_SECRET=
